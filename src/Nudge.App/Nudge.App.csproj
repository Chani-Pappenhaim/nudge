<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon, which WPF does not provide. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Nudge</AssemblyName>
    <ApplicationIcon>Assets\nudge.ico</ApplicationIcon>
    <!-- The Fluent theme is marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nudge.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nudge.Infrastructure\Nudge.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

</Project>
