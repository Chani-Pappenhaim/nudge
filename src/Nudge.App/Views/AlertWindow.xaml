<Window x:Class="Nudge.App.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nudge.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AlertViewModel}"
        Title="{Binding Title}" Icon="/Assets/nudge.ico"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        FlowDirection="RightToLeft">

  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,3,1,1"
          CornerRadius="12" Padding="18,14,18,16" Margin="4" MouseLeftButtonDown="OnDragAreaPressed">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding WhenText}" Style="{StaticResource MutedText}" Margin="8,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                ToolTip="סגירה (דחייה ב-5 דקות)" AutomationProperties.Name="סגירה" Command="{Binding SnoozeCommand}"
                CommandParameter="{x:Static vm:AlertViewModel.DefaultSnoozeMinutes}" />
      </Grid>

      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                 Visibility="{Binding HasNote, Converter={StaticResource VisibleWhenTrue}}" />
      <TextBlock Text="{Binding RecurrenceText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

      <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Margin="0,14,0,0"
              AutomationProperties.Name="סמן כבוצע" Command="{Binding CompleteCommand}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,0,8,0" />
          <TextBlock Text="סמן כבוצע" />
        </StackPanel>
      </Button>

      <DockPanel Margin="0,10,0,0">
        <TextBlock Text="דחייה:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ItemsControl ItemsSource="{x:Static vm:AlertViewModel.SnoozeOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="2" Padding="0,5" HorizontalAlignment="Stretch"
                      Content="{Binding Label}"
                      Command="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Value}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <Button HorizontalAlignment="Stretch" Padding="0,5" Margin="2,6,2,0"
              AutomationProperties.Name="דחייה למועד אחר" Command="{Binding SnoozeToChosenTimeCommand}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" Margin="0,0,8,0" />
          <TextBlock Text="מועד אחר…" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Border>
</Window>
