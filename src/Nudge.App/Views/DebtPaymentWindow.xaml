<Window x:Class="Nudge.App.Views.DebtPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nudge.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DebtPaymentViewModel}"
        Title="רישום החזר" Icon="/Assets/nudge.ico"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft">

  <StackPanel Margin="24,12,24,20">
    <TextBlock Text="רישום החזר" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

    <TextBlock Text="כמה הוחזר (₪)" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="AmountBox" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
             AutomationProperties.Name="סכום ההחזר" />

    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
      <Button Content="ביטול" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
      <Button Content="רישום" IsDefault="True" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
