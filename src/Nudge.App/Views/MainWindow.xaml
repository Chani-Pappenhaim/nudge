<Window x:Class="Nudge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nudge.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Nudge" Icon="/Assets/nudge.ico"
        Width="580" Height="660" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ReminderItemViewModel}">
      <Border x:Name="Card" Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border x:Name="StatusBar" Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}" />

          <StackPanel Grid.Column="1" Margin="12,0">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasNote, Converter={StaticResource VisibleWhenTrue}}" />
            <WrapPanel Margin="0,6,0,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,5,0" />
              <TextBlock Text="{Binding WhenText}" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,5,0" />
              <TextBlock Text="{Binding RecurrenceText}" Style="{StaticResource MutedText}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="עריכה" AutomationProperties.Name="עריכה"
                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="{Binding ToggleGlyph}" ToolTip="{Binding ToggleToolTip}" AutomationProperties.Name="{Binding ToggleToolTip}"
                    Command="{Binding DataContext.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="מחיקה" AutomationProperties.Name="מחיקה" Foreground="{StaticResource DangerBrush}"
                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="False">
          <Setter TargetName="StatusBar" Property="Background" Value="{StaticResource InactiveBrush}" />
          <Setter TargetName="Card" Property="Opacity" Value="0.6" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
      <Border Style="{StaticResource Card}" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
          <StackPanel Grid.Column="1" Margin="12,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActionText}" Style="{StaticResource MutedText}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DebtItemViewModel}">
      <Border x:Name="Card" Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border x:Name="SideBar" Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}" />

          <StackPanel Grid.Column="1" Margin="12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Person}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <Border x:Name="Badge" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                      Background="{StaticResource AccentBrush}">
                <TextBlock Text="{Binding DirectionText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}" />
              </Border>
            </StackPanel>
            <WrapPanel Margin="0,4,0,0">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding AmountGlyph}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
              <TextBlock x:Name="AmountLine" Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            </WrapPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhenTrue}}" />
            <WrapPanel Margin="0,4,0,0" Visibility="{Binding HasReminder, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,5,0" />
              <TextBlock Text="{Binding ReminderText}" Style="{StaticResource MutedText}" />
            </WrapPanel>
            <TextBlock Text="{Binding SettledText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Visibility="{Binding IsSettled, Converter={StaticResource VisibleWhenTrue}}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}">
            <Button Style="{StaticResource IconButton}" Content="&#xE8C7;" ToolTip="רישום החזר" AutomationProperties.Name="רישום החזר"
                    Visibility="{Binding IsMoney, Converter={StaticResource VisibleWhenTrue}}"
                    Command="{Binding DataContext.RecordPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="{Binding UndoPaymentToolTip}" AutomationProperties.Name="ביטול החזר אחרון"
                    Visibility="{Binding CanUndoPayment, Converter={StaticResource VisibleWhenTrue}}"
                    Command="{Binding DataContext.UndoPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE73E;" ToolTip="הוחזר במלואו" AutomationProperties.Name="הוחזר"
                    Foreground="{StaticResource AccentBrush}"
                    Command="{Binding DataContext.SettleDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xEA8F;" ToolTip="{Binding ReminderToolTip}" AutomationProperties.Name="תזכורת"
                    Command="{Binding DataContext.DebtReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="עריכה" AutomationProperties.Name="עריכה"
                    Command="{Binding DataContext.EditDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="מחיקה" AutomationProperties.Name="מחיקה" Foreground="{StaticResource DangerBrush}"
                    Command="{Binding DataContext.DeleteDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding IsSettled, Converter={StaticResource VisibleWhenTrue}}">
            <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="החזרה לחובות הפתוחים" AutomationProperties.Name="ביטול סימון הוחזר"
                    Command="{Binding DataContext.ReopenDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="מחיקה" AutomationProperties.Name="מחיקה" Foreground="{StaticResource DangerBrush}"
                    Command="{Binding DataContext.DeleteDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsOwedToMe}" Value="False">
          <Setter TargetName="SideBar" Property="Background" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="AmountLine" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOpen}" Value="False">
          <Setter TargetName="SideBar" Property="Background" Value="{StaticResource InactiveBrush}" />
          <Setter TargetName="Card" Property="Opacity" Value="0.7" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One segment of a switcher; the checked segment is filled with its Tag brush. -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Tag" Value="{StaticResource AccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chip" CornerRadius="14" Padding="12,5" Margin="0,0,6,6" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
              <ContentPresenter TextElement.FontWeight="SemiBold" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Nudge" FontSize="26" FontWeight="SemiBold" />
          <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="4,12,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Content="הפעלה אוטומטית עם Windows" IsChecked="{Binding StartWithWindows}" Margin="0,4,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource AccentButton}" VerticalAlignment="Top" Margin="0,4,0,0"
              AutomationProperties.Name="תזכורת חדשה" Command="{Binding NewReminderCommand}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
          <TextBlock Text="תזכורת חדשה" />
        </StackPanel>
      </Button>
    </Grid>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Width" Value="110" />
        </Style>
      </TabControl.Resources>
      <TabItem Header="תזכורות">
        <Grid Margin="0,12,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Reminders}" />
          </ScrollViewer>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding NoReminders, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="40" HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="אין עדיין תזכורות" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Text="לחיצה על &quot;תזכורת חדשה&quot; תיצור את הראשונה." Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="חובות">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <WrapPanel Margin="0,0,0,6">
            <RadioButton Style="{StaticResource Segment}" GroupName="DebtView" Tag="{StaticResource WarningBrush}"
                         Content="{Binding IOweTotal}" AutomationProperties.Name="אני חייבת" IsChecked="{Binding ShowIOwe}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="DebtView"
                         Content="{Binding OwedToMeTotal}" AutomationProperties.Name="חייבים לי" IsChecked="{Binding ShowOwedToMe}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="DebtView" Tag="{StaticResource MutedTextBrush}"
                         Content="{Binding SettledHeader}" AutomationProperties.Name="הוחזרו" IsChecked="{Binding ShowSettled}" />
          </WrapPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding IOwe}" Visibility="{Binding ShowIOwe, Converter={StaticResource VisibleWhenTrue}}" />
              <ItemsControl ItemsSource="{Binding OwedToMe}" Visibility="{Binding ShowOwedToMe, Converter={StaticResource VisibleWhenTrue}}" />
              <ItemsControl ItemsSource="{Binding SettledDebts}" Visibility="{Binding ShowSettled, Converter={StaticResource VisibleWhenTrue}}" />

              <StackPanel Margin="0,40,0,24" HorizontalAlignment="Center"
                          Visibility="{Binding NoDebtsInView, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C7;" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding DebtsEmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding DebtsEmptyHint}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Button Grid.Row="2" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="חוב חדש"
                  Command="{Binding NewDebtCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
              <TextBlock Text="חוב חדש" />
            </StackPanel>
          </Button>
        </Grid>
      </TabItem>
      <TabItem Header="היסטוריה">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding History}" />
          </ScrollViewer>
          <TextBlock Text="עדיין אין פעולות בהיסטוריה." Style="{StaticResource MutedText}" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding NoHistory, Converter={StaticResource VisibleWhenTrue}}" />
          <Button Grid.Row="1" Content="ניקוי היסטוריה" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Command="{Binding ClearHistoryCommand}" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
