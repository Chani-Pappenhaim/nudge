<Window x:Class="Nudge.App.Views.ReminderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nudge.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReminderEditorViewModel}"
        Title="{Binding WindowTitle}" Icon="/Assets/nudge.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft">

  <StackPanel Margin="24,12,24,20">
    <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold" />

    <TextBlock Text="כותרת" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="הערה (לא חובה)" Style="{StaticResource FieldLabel}" />
    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
             TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="110" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="תאריך" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding Date}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="שעה" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                 HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="110" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="חזרה" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{x:Static vm:ReminderEditorViewModel.RecurrenceOptions}"
                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Recurrence}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Visibility="{Binding IsInterval, Converter={StaticResource VisibleWhenTrue}}">
        <TextBlock Text="כל כמה דקות" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                 HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <TextBlock Text="צליל" Style="{StaticResource FieldLabel}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{x:Static vm:ReminderEditorViewModel.SoundOptions}"
                DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sound}" />
      <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="השמעה" AutomationProperties.Name="השמעה"
              Margin="8,0,0,0" Command="{Binding PreviewSoundCommand}" />
    </Grid>

    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
      <Button Content="ביטול" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
      <Button Content="שמירה" IsDefault="True" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
